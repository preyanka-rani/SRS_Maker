# Placeholders only. Copy to .env and fill in. Never commit .env.
APP_ENV=development
APP_SECRET_KEY=<generate-64-hex>
JWT_TTL_MINUTES=30
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://srs:<password>@postgres:5432/srs
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=25

# Added in later phases
GEMINI_API_KEY=<secret>
GEMINI_MODEL_REASONING=<verified model id>
GEMINI_MODEL_FAST=<verified model id>
GROQ_API_KEY=<secret>
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# ==================== EMAIL (IMAP) ====================
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=<system-mailbox@example.com>
IMAP_PASSWORD=<app-password>

# ==================== EMAIL (SMTP) ====================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=<system-mailbox@example.com>
SMTP_PASSWORD=<app-password>
SMTP_FROM_NAME=SRS GENERATION SYSTEM

# ==================== LOCAL RUN (no Redis / Docker) ====================
LOCAL_SCHEDULER=true            # in-process mailbox poller + outbox sender
AUTO_CREATE_PROJECT_FROM_EMAIL=true
AUTO_CONSENT_POLICY_REFERENCE=mailbox-intake-default-policy
TRUSTED_AUTHSERV_IDS=mx.google.com
IMAP_POLL_INTERVAL_SECONDS=60

# local run
ADMIN_EMAIL=<admin@example.com>
ADMIN_PASSWORD=<choose-a-strong-password>
